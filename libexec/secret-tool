#!/bin/sh
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  if [ -n "${WSL_INTEROP:-}" ]; then
    printf '%s\n' "secret-tool (Windows CurrentUser DPAPI)"
  else
    printf '%s\n' "secret-tool (libsecret-tools)"
  fi
  exit 0
fi
if [ -n "${WSL_INTEROP:-}" ]; then
  exec node "$(dirname "$0")/windows-dpapi-secret-tool.mjs" "$@"
fi
exec /usr/bin/secret-tool "$@"
