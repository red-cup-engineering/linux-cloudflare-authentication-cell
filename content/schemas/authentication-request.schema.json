{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-cloudflare-authentication.actions.561.group/schemas/authentication-request.schema.json",
  "title": "Authenticate a Linux colony with a Cloudflare colony",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "expectedAccountId", "scopes", "settlementDirectory"],
  "properties": {
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "expectedAccountId": { "type": "string", "pattern": "^[A-Fa-f0-9]{32}$" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "settlementDirectory": { "type": "string", "minLength": 1 },
    "browser": { "type": "boolean" },
    "callbackHost": { "enum": ["localhost", "127.0.0.1", "::1"] },
    "callbackPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
  }
}
