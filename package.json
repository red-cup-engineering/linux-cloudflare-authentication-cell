{
  "name": "@red-cup-engineering/linux-cloudflare-authentication-service",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Initiates one explicitly scoped Cloudflare OAuth authorization from a Linux settlement, stores it through Wrangler named-profile keyring custody, verifies the account binding, and returns a non-secret receipt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/linux-cloudflare-authentication-cell.git"
  },
  "homepage": "https://linux-cloudflare-authentication.actions.561.group/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "authenticate-linux-colony-with-cloudflare": "./bin/authenticate-linux-colony-with-cloudflare.mjs"
  },
  "exports": {
    ".": "./src/authenticate-linux-colony-with-cloudflare.mjs",
    "./libexec/secret-tool": "./libexec/secret-tool"
  },
  "types": "./types/index.d.mts",
  "files": [
    "bin",
    "content",
    "data/manifest",
    "libexec",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "materialize-manifest": "node ops/materialize-manifest.mjs",
    "test": "node --test",
    "check": "node --check bin/authenticate-linux-colony-with-cloudflare.mjs && node --check src/authenticate-linux-colony-with-cloudflare.mjs && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@lenticule-science/rmn-semantic-conformance-die": "6.0.1",
    "@red-cup-engineering/activitypub-services-section": "1.0.2",
    "@red-cup-engineering/authority-custody-actuator": "1.0.0",
    "@red-cup-engineering/typed-resource-catalog": "0.1.1",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22"
  }
}
